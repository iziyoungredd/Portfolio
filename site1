                        </svg>
                    </div>
                </div>`,
                desc: 'Circular ceremonial medallion featuring an inverted gold Ankh set against a deep ruby backdrop on a 30-inch gold link.'
            }
        ];

        let cart = [];

        // 2. RENDER PRODUCTS
        function renderProducts(filter = 'all') {
            const productGrid = document.getElementById('productGrid');
            const filtered = filter === 'all' ? PRODUCTS : PRODUCTS.filter(p => p.category === filter);
            
            productGrid.innerHTML = filtered.map(p => `
                <div class="group bg-obsidianLight border border-obsidianBorder rounded-2xl p-5 flex flex-col justify-between transition-all duration-300 hover:border-unkhMagenta/50 hover:shadow-neon-magenta">
                    <div>
                        <!-- Product Graphic View -->
                        <div class="aspect-square rounded-xl bg-obsidian border border-obsidianBorder flex items-center justify-center p-6 relative overflow-hidden mb-4 group-hover:scale-105 transition-transform duration-300">
                            ${p.imageSvg}
                            <button onclick="openQuickView('${p.id}')" class="absolute bottom-3 right-3 bg-obsidian/80 text-white w-8 h-8 rounded-full border border-obsidianBorder flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:border-unkhMagenta">
                                <i class="fa-solid fa-eye text-xs"></i>
                            </button>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-unkhMagenta">${p.category}</span>
                        <h3 class="brand-font font-bold text-base text-white mt-1 group-hover:text-unkhRed transition-colors">${p.name}</h3>
                    </div>
                    <div class="mt-6 flex items-center justify-between border-t border-obsidianBorder pt-4">
                        <span class="brand-font text-lg font-bold text-unkhGold">$${p.price}</span>
                        <button onclick="addToCart('${p.id}')" class="px-4 py-2 rounded-full border border-unkhRed/40 bg-unkhRed/10 hover:bg-unkhRed text-white text-xs font-semibold uppercase tracking-wider transition-all hover:shadow-neon-red">
                            Add Relic
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Filter Button Toggles
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => {
                    b.classList.remove('active', 'bg-gradient-to-r', 'from-unkhRed', 'to-unkhMagenta', 'text-white', 'shadow-neon-magenta');
                    b.classList.add('border', 'border-obsidianBorder', 'bg-obsidianLight', 'text-gray-400');
                });
                btn.classList.add('active', 'bg-gradient-to-r', 'from-unkhRed', 'to-unkhMagenta', 'text-white', 'shadow-neon-magenta');
                btn.classList.remove('border', 'border-obsidianBorder', 'bg-obsidianLight', 'text-gray-400');
                renderProducts(btn.dataset.filter);
            });
        });

        // 3. CART SYSTEM
        function addToCart(productId, customData = null) {
            if (customData) {
                cart.push(customData);
            } else {
                const prod = PRODUCTS.find(p => p.id === productId);
                if (!prod) return;
                const existing = cart.find(item => item.id === productId && !item.isCustom);
                if (existing) {
                    existing.qty += 1;
                } else {
                    cart.push({ ...prod, qty: 1, isCustom: false });
                }
            }
            updateCartUI();
            openCartDrawer();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cartBadge');
            const drawerCount = document.getElementById('drawerCartCount');
            const container = document.getElementById('cartItemsContainer');
            const emptyMsg = document.getElementById('emptyCartMsg');
            const subtotalEl = document.getElementById('cartSubtotal');

            const totalItems = cart.reduce((sum, item) => sum + (item.qty || 1), 0);
            badge.textContent = totalItems;
            drawerCount.textContent = totalItems;

            if (totalItems > 0) {
                badge.classList.remove('hidden');
                emptyMsg.classList.add('hidden');
            } else {
                badge.classList.add('hidden');
                emptyMsg.classList.remove('hidden');
            }

            let subtotal = 0;
            container.innerHTML = cart.map((item, idx) => {
                const itemPrice = item.price * (item.qty || 1);
                subtotal += itemPrice;
                return `
                    <div class="flex items-center justify-between p-3 bg-obsidian border border-obsidianBorder rounded-xl">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-lg bg-obsidianLight border border-obsidianBorder flex items-center justify-center p-2 text-unkhMagenta">
                                ${item.imageSvg || '<i class="fa-solid fa-gem text-xl"></i>'}
                            </div>
                            <div>
                                <h4 class="brand-font font-bold text-xs text-white">${item.name}</h4>
                                <span class="text-[11px] text-unkhGold font-mono">$${item.price} ${item.qty > 1 ? `x ${item.qty}` : ''}</span>
                                ${item.engraving ? `<p class="text-[9px] text-gray-500 font-mono">ENGRAVING: ${item.engraving}</p>` : ''}
                            </div>
                        </div>
                        <button onclick="removeFromCart(${idx})" class="text-gray-500 hover:text-unkhRed p-2">
                            <i class="fa-solid fa-trash text-xs"></i>
                        </button>
                    </div>
                `;
            }).join('');

            subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
        }

        // Cart Drawer Controls
        const cartDrawer = document.getElementById('cartDrawer');
        const cartPanel = document.getElementById('cartPanel');

        function openCartDrawer() {
            cartDrawer.classList.remove('pointer-events-none', 'opacity-0');
            cartDrawer.classList.add('opacity-100');
            cartPanel.classList.remove('translate-x-full');
        }
        function closeCartDrawer() {
            cartDrawer.classList.add('pointer-events-none', 'opacity-0');
            cartDrawer.classList.remove('opacity-100');
            cartPanel.classList.add('translate-x-full');
        }

        document.getElementById('openCartBtn').addEventListener('click', openCartDrawer);
        document.getElementById('closeCartBtn').addEventListener('click', closeCartDrawer);
        document.getElementById('cartOverlay').addEventListener('click', closeCartDrawer);

        // 4. QUICK VIEW MODAL LOGIC
        const quickViewModal = document.getElementById('quickViewModal');
        const quickViewPanel = document.getElementById('quickViewPanel');
        let currentQVProduct = null;

        function openQuickView(productId) {
            const prod = PRODUCTS.find(p => p.id === productId);
            if (!prod) return;
            currentQVProduct = prod;

            document.getElementById('qvImage').innerHTML = prod.imageSvg;
            document.getElementById('qvCategory').textContent = prod.category;
            document.getElementById('qvTitle').textContent = prod.name;
            document.getElementById('qvPrice').textContent = `$${prod.price}`;
            document.getElementById('qvDesc').textContent = prod.desc;

            quickViewModal.classList.remove('opacity-0', 'pointer-events-none');
            quickViewPanel.classList.remove('scale-95');
        }

        function closeQuickView() {
            quickViewModal.classList.add('opacity-0', 'pointer-events-none');
            quickViewPanel.classList.add('scale-95');
        }

        document.getElementById('closeQuickView').addEventListener('click', closeQuickView);
        document.getElementById('quickViewOverlay').addEventListener('click', closeQuickView);
        document.getElementById('qvAddToCartBtn').addEventListener('click', () => {
            if (currentQVProduct) addToCart(currentQVProduct.id);
            closeQuickView();
        });

        // 5. ATELIER CUSTOMIZER INTERACTIVITY
        let customizerState = {
            finish: 'gold',
            color: '#D4AF37',
            glow: 'rgba(212,175,55,0.4)',
            orientation: 'inverted',
            engraving: '',
            price: 490
        };

        const customizerSvg = document.getElementById('customizerSvg');
        const customizerGraphicContainer = document.getElementById('customizerGraphicContainer');
        const previewGlow = document.getElementById('previewGlow');
        const previewEngravingText = document.getElementById('previewEngravingText');
        const engravingInput = document.getElementById('engravingInput');

        document.querySelectorAll('.finish-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.finish-btn').forEach(b => b.classList.remove('active', 'border-unkhGold', 'border-unkhRed', 'border-unkhMagenta'));
                btn.classList.add('active');
                
                customizerState.finish = btn.dataset.finish;
                customizerState.color = btn.dataset.color;
                customizerState.glow = btn.dataset.glow;

                updateCustomizerPreview();
            });
        });

        document.querySelectorAll('.orient-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.orient-btn').forEach(b => {
                    b.classList.remove('active', 'border-unkhMagenta', 'text-white');
                    b.classList.add('border-obsidianBorder', 'text-gray-400');
                });
                btn.classList.add('active', 'border-unkhMagenta', 'text-white');
                btn.classList.remove('border-obsidianBorder', 'text-gray-400');

                customizerState.orientation = btn.dataset.orientation;
                updateCustomizerPreview();
            });
        });

        engravingInput.addEventListener('input', (e) => {
            customizerState.engraving = e.target.value.toUpperCase();
            previewEngravingText.textContent = customizerState.engraving ? `✦ ${customizerState.engraving} ✦` : '';
        });

        function updateCustomizerPreview() {
            customizerSvg.setAttribute('fill', customizerState.color);
            previewGlow.style.backgroundColor = customizerState.glow;

            if (customizerState.orientation === 'inverted') {
                customizerGraphicContainer.classList.add('rotate-180');
                document.getElementById('specOrientation').textContent = 'Orientation: Inverted';
            } else {
                customizerGraphicContainer.classList.remove('rotate-180');
                document.getElementById('specOrientation').textContent = 'Orientation: Classic Upright';
            }

            document.getElementById('specFinish').textContent = `Finish: ${customizerState.finish.toUpperCase()}`;
        }

        document.getElementById('addCustomToCartBtn').addEventListener('click', () => {
            const customProduct = {
                id: 'custom_' + Date.now(),
                name: `Custom ${customizerState.finish.toUpperCase()} Ankh (${customizerState.orientation})`,
                price: customizerState.price,
                engraving: customizerState.engraving || 'NONE',
                qty: 1,
                isCustom: true,
                imageSvg: `<svg class="w-8 h-10" viewBox="0 0 100 140" fill="${customizerState.color}"><path d="M50,140 C35,140 25,125 25,100 C25,75 42,60 50,60 C58,60 75,75 75,100 C75,125 65,140 50,140 Z M50,122 C58,122 61,112 61,100 C61,85 54,74 50,74 C46,74 39,85 39,100 C39,112 42,122 50,122 Z M10,50 L90,50 L90,38 L57,38 L57,0 L43,0 L43,38 L10,38 Z"/></svg>`
            };
            addToCart(null, customProduct);
        });

        // 6. HERO ANKH TOGGLE DUALITY
        const heroAnkhToggle = document.getElementById('heroAnkhToggle');
        const heroAnkhSvg = document.getElementById('heroAnkhSvg');
        let heroInverted = true;

        heroAnkhToggle.addEventListener('click', () => {
            heroInverted = !heroInverted;
            if (heroInverted) {
                heroAnkhSvg.classList.add('rotate-180');
            } else {
                heroAnkhSvg.classList.remove('rotate-180');
            }
        });

        // 7. SACRED SYMBOLISM SVG INTERACTION
        document.querySelectorAll('.symbol-part').forEach(part => {
            part.addEventListener('click', () => {
                const targetName = part.dataset.part;
                document.querySelectorAll('.symbol-info-card').forEach(card => {
                    if (card.dataset.target === targetName) {
                        card.classList.add('border-unkhMagenta', 'shadow-neon-magenta');
                    } else {
                        card.classList.remove('border-unkhMagenta', 'shadow-neon-magenta');
                    }
                });
            });
        });

        // 8. NEWSLETTER FORM
        document.getElementById('newsletterForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.getElementById('newsletterSuccess').classList.remove('hidden');
            e.target.reset();
        });

        // 9. MOBILE MENU TOGGLE
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // 10. HERO CANVAS ANIMATION (Floating Sacred Geometry Particles)
        const canvas = document.getElementById('heroCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.5;
                this.speedY = (Math.random() - 0.5) * 0.5;
                this.color = Math.random() > 0.5 ? '#DC2626' : '#E11D48';
                this.opacity = Math.random() * 0.5 + 0.2;
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) {
                    this.reset();
                }
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.globalAlpha = this.opacity;
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;
                ctx.fill();
                ctx.globalAlpha = 1.0;
            }
        }

        const particles = Array.from({ length: 45 }, () => new Particle());

        function animateHeroCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateHeroCanvas);
        }

        // 11. HISTORY SECTION INTERACTIVITY DATA & LOGIC
        const HISTORY_DATA = {
            genesis: {
                period: "c. 3000 BCE — Early Dynastic Kemet",
                title: "The Breath of Eternal Creation",
                desc: "In early Egyptian mythology, the Ankh was the supreme symbol of life, regeneration, and water. Depicted held to the nostrils of pharaohs by deities such as Isis, Osiris, and Ra, it imparted the divine breath required for spiritual awakening and immortality beyond physical death.",
                concepts: ["✦ Key of Life", "✦ Cosmic Womb", "✦ Nile Energy"],
                color: "#D4AF37",
                inverted: false,
                caption: "Upright Kemetic Key"
            },
            pharaohs: {
                period: "c. 1550 BCE — New Kingdom Dynasty",
                title: "Regal Power & Sacred Alchemy",
                desc: "Pharaohs carried mirror-polished gold Ankhs into battle and coronation rituals. It was believed that the upper loop mirrored the sun (Ra) rising over the horizon, while the arms represented the two lands of Egypt united under sovereign divine rule.",
                concepts: ["✦ Pharaoh's Crown", "✦ Solar Ra", "✦ Royal Balance"],
                color: "#DC2626",
                inverted: false,
                caption: "Golden Scepter Emblem"
            },
            hermetic: {
                period: "c. 300 CE — Hermetic & Coptic Era",
                title: "As Above, So Below",
                desc: "As Kemetic wisdom blended with Gnostic and Hermetic traditions, the Ankh transformed into the 'Crux Ansata' (handled cross). Esoteric scholars realized the loop symbolised higher consciousness while the horizontal axis represented physical incarnation.",
                concepts: ["✦ Crux Ansata", "✦ Dual Realms", "✦ Sacred Geometry"],
                color: "#E11D48",
                inverted: false,
                caption: "Hermetic Handled Cross"
            },
            inverted: {
                period: "Present Day — Upside Down Unkh",
                title: "Grounding Spirit Into Reality",
                desc: "By turning the sacred Ankh upside down, we complete the circuit of manifestation. Rather than reaching outward toward unattainable heavens, the inverted loop acts as an anchor—channelling divine cosmic power straight down into the physical earth and modern sovereign action.",
                concepts: ["✦ Physical Manifestation", "✦ Grounded Light", "✦ Modern Sovereignty"],
                color: "#FF007F",
                inverted: true,
                caption: "Inverted Manifestation Engine"
            }
        };

        document.querySelectorAll('.history-tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.history-tab-btn').forEach(b => {
                    b.classList.remove('active', 'bg-gradient-to-r', 'from-unkhRed', 'to-unkhMagenta', 'text-white', 'shadow-neon-magenta');
                    b.classList.add('border', 'border-obsidianBorder', 'bg-obsidianLight', 'text-gray-400');
                });
                btn.classList.add('active', 'bg-gradient-to-r', 'from-unkhRed', 'to-unkhMagenta', 'text-white', 'shadow-neon-magenta');
                btn.classList.remove('border', 'border-obsidianBorder', 'bg-obsidianLight', 'text-gray-400');

                const data = HISTORY_DATA[btn.dataset.epoch];
                if (data) {
                    document.getElementById('epochPeriod').textContent = data.period;
                    document.getElementById('epochTitle').textContent = data.title;
                    document.getElementById('epochDesc').textContent = data.desc;
                    document.getElementById('epochVisualCaption').textContent = data.caption;
                    document.getElementById('epochKeyConcepts').innerHTML = data.concepts.map(c => `
                        <span class="px-3 py-1 rounded-md bg-obsidian border border-obsidianBorder text-white">${c}</span>
                    `).join('');

                    const svg = document.querySelector('#epochVisual svg');
                    svg.setAttribute('fill', data.color);
                    if (data.inverted) {
                        svg.classList.add('rotate-180');
                    } else {
                        svg.classList.remove('rotate-180');
                    }
                }
            });
        });

        window.onload = function() {
            renderProducts();
            updateCustomizerPreview();
            animateHeroCanvas();
        }
    </script>
</body>
</html>
